# Copy this file to .env for local use. In Coolify, add these in the Environment tab instead.

# --- API ---
# Local default is a file database. In Coolify use a PostgreSQL database URL, otherwise
# data is lost every time you redeploy.
DATABASE_URL=sqlite:///./quickstack.db
# Make this a long random string in real use
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Website address(es) allowed to call the API, comma separated. Set to your UI address in Coolify.
CORS_ORIGINS=http://localhost:3000

# --- UI (built into the website at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Features (1 = on, 0 = off). Only quotes exists so far. ---
FEATURE_QUOTES=1
FEATURE_INVOICING=0
FEATURE_CALENDAR=0
FEATURE_TEAM_MANAGEMENT=0
FEATURE_LIVE_UPDATES=0
