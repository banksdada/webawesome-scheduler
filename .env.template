# Copy this file to .env for local use. In Coolify, add these in the Environment tab instead.

# --- API ---
# Local default is a file database. In Coolify use a PostgreSQL database URL, otherwise
# data is lost every time you redeploy.
DATABASE_URL=sqlite:///./scheduler.db
# Make this a long random string. Anyone who knows it can forge logins.
SECRET_KEY=change-me
# How long a login lasts (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Website address(es) allowed to call the API, comma separated. Set to your website address in Coolify.
CORS_ORIGINS=http://localhost:3000
# Times in emails are shown in this timezone
TIMEZONE=Europe/London

# --- Email to technicians when a job is assigned (optional) ---
# Leave SMTP_HOST empty and no emails are sent (the app still works).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=scheduler@yourdomain.com
SMTP_TLS=1

# Text messages to technicians (Twilio). Leave empty and no texts are sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
DEFAULT_COUNTRY_CODE=44
# The website's address, so texts can link to the technician's jobs
SITE_URL=

# --- Website (built into the website at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
